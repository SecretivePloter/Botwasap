# Gunakan Service Role Key (bukan anon key), ada di Supabase Dashboard > Settings > API > service_role
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── Cookie downloader (opsional) ──
# Instagram/Facebook/Threads sekarang maksa login. Isi salah satu di bawah biar bisa download.
# 1) Path ke file cookies.txt (format Netscape, hasil export dari browser yang login):
# YTDLP_COOKIES=D:\IT\program\Botwasap\cookies.txt
# 2) ATAU ambil cookie langsung dari browser yang login di komputer bot:
# YTDLP_COOKIES_BROWSER=chrome
